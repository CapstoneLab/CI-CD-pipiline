# Copy the required values into the existing .env file.
ENGINE_SHARED_TOKEN=replace-with-the-same-token-used-by-the-backend
ENGINE_ID=ubuntu-engine-01
POLL_INTERVAL_SEC=15
POLL_FETCH_LIMIT=5
ANTHROPIC_API_KEY=

# docker/compose-up.sh sets this automatically. Set it manually only when
# invoking docker compose without the helper.
ENGINE_DATA_ROOT=/absolute/path/to/CICD-Engine/.docker-data

BACKEND_IMAGE=yakdoll/capstone-back:125291b89076d4db1f4970a9c84aa21da60cbdac
# Keep 0.0.0.0 when external clients call port 8000 directly. Use 127.0.0.1
# when a reverse proxy on this host is the only intended entry point.
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
CAPSTONE_NETWORK_NAME=capstone-internal
